# Serves the live release through the www/current symlink. The symlink is resolved when a file is
# opened, so a download that started before a swap keeps streaming the old file.
#
# TLS is off because this container is meant to sit behind a reverse proxy or load balancer that
# terminates HTTPS for example.com. To let this Caddy obtain certificates itself, replace `:80` with
# `example.com`, remove `auto_https off` and publish ports 80 and 443 in docker-compose.yml.
#
# Deliberately NOT set: `grace_period`. Caddy applies it on config reloads too, so any value would
# force-close slow downloads during an ordinary deploy. Docker's stop_grace_period bounds shutdown.
{
	auto_https off
}

:80 {
	root * /www/current
	encode zstd gzip

	# Pages and the version marker change on every deploy.
	@fresh path / *.html */ *.xml /version.txt
	header @fresh Cache-Control "no-cache"

	# Content-hashed build output (adjust the path to your generator's asset folder).
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	header {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		Referrer-Policy strict-origin-when-cross-origin
		X-Content-Type-Options nosniff
		-Server
	}

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
